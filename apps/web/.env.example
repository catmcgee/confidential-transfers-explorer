# JWT Secret for authentication
JWT_SECRET=your-super-secret-jwt-key-change-this

# Public environment variables (accessible in browser)
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_NETWORK_NAME=devnet

# Faucet configuration
# Your wallet's private key (base58 or JSON array format)
# This wallet should have CT-enabled tokens to distribute
FAUCET_PRIVATE_KEY=
# CT-enabled mint (create one with: bun run setup:mint)
CT_FAUCET_MINT=
# Mint keypair (for minting more tokens) - base58 secret key
MINT_SECRET_KEY=
