{
  "name": "ct-explorer",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "bun run --filter @ct-explorer/web dev",
    "build": "bun run --filter '*' build",
    "build:shared": "bun run --filter @ct-explorer/shared build",
    "lint": "bun run --filter '*' lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "bun run --filter '*' typecheck",
    "setup:mint": "cd apps/web && bun run ../../scripts/setup-ct-mint.ts",
    "mint:more": "cd apps/web && bun run ../../scripts/mint-more.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@next/eslint-plugin-next": "^15",
    "@types/bun": "^1.4.2",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  },
  "dependencies": {
    "@solana-program/token-2022": "^0.19.0",
    "@solana/kit": "^8.4.0",
    "@solana/zk-sdk": "^0.5.3"
  },
  "overrides": {
    "next@<15.5.27": "^15.5.27",
    "sharp@<0.35.5": "^0.35.5",
    "source-map-js@<1.2.2": "^1.2.2",
    "postcss-selector-parser@<7.1.6": "^7.1.6",
    "stream-json@<3.6.0": "^3.6.0",
    "brace-expansion@<1.1.21": "^1.1.21",
    "js-yaml@<4.3.2": "^4.3.2",
    "baseline-browser-mapping@<2.11.0": "^2.11.0",
    "@humanfs/node@<0.16.8": "^0.16.8",
    "nanoid@<3.3.18": "^3.3.18",
    "browserslist@<4.28.7": "^4.28.7",
    "postcss@<8.5.23": "^8.5.23",
    "ws@<7.5.11": "^7.5.11",
    "ws@>=8.0.0 <8.21.0": "^8.21.0",
    "uuid@<11.1.1": "^11.1.1",
    "picomatch@<2.3.2": "^2.3.2",
    "picomatch@>=3.0.0 <4.0.4": "^4.0.4",
    "flatted@<3.4.2": "^3.4.2",
    "minimatch@<3.1.3": "^3.1.3",
    "bn.js@<5.2.3": "^5.2.3"
  }
}
